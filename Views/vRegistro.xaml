<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ftibantaExamen.Views.vRegistro"
             Title="Registro">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label x:Name="lblUsuario"
                   Style="{StaticResource usuarioGlobal}"/>

            <Label Text="REGISTRO"
                   TextColor="Blue"
                   FontSize="22"
                   HorizontalOptions="Center"/>

            <!--GRID 2 FILAS x 3 COLUMNAS-->
            <Grid RowSpacing="10"
                  ColumnSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Text="Nombre"
                       Style="{StaticResource labelGlobal}"
                       Grid.Row="0"
                       Grid.Column="0"/>

                <Label Text="Apellido"
                       Style="{StaticResource labelGlobal}"
                       Grid.Row="0"
                       Grid.Column="1"/>

                <Label Text="Edad"
                       Style="{StaticResource labelGlobal}"
                       Grid.Row="0"
                       Grid.Column="2"/>

                <Entry x:Name="txtNombre"
                       Style="{StaticResource entryGlobal}"
                       Placeholder="Ingresar Nombre"
                       Grid.Row="1"
                       Grid.Column="0"/>

                <Entry x:Name="txtApellido"
                       Style="{StaticResource entryGlobal}"
                       Placeholder="Ingresar Apellido"
                       Grid.Row="1"
                       Grid.Column="1"/>

                <Entry x:Name="txtEdad"
                       Style="{StaticResource entryGlobal}"
                       Placeholder="Ingresar Edad"
                       Keyboard="Numeric"
                       MaxLength="3"
                       TextChanged="txtEdad_TextChanged"
                       Grid.Row="1"
                       Grid.Column="2"/>
            </Grid>

            <!--GRID 5 FILAS x 2 COLUMNAS-->
            <Grid RowSpacing="10"
                  ColumnSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Text="Fecha de inicio"
                       Style="{StaticResource labelGlobal}"
                       Grid.Row="0"
                       Grid.Column="0"/>

                <DatePicker x:Name="dpFechaInicio"
                            Format="dd/MM/yyyy"
                            Grid.Row="0"
                            Grid.Column="1"/>

                <Label Text="Plan"
                       Style="{StaticResource labelGlobal}"
                       Grid.Row="1"
                       Grid.Column="0"/>

                <Picker x:Name="pkPlan"
                        Title="Seleccione un plan"
                        Grid.Row="1"
                        Grid.Column="1">
                    <Picker.Items>
                        <x:String>Musculacion</x:String>
                        <x:String>Cardio</x:String>
                        <x:String>Crossfit</x:String>
                        <x:String>Full</x:String>
                    </Picker.Items>
                </Picker>

                <Label Text="Casillero"
                       Style="{StaticResource labelGlobal}"
                       Grid.Row="2"
                       Grid.Column="0"/>

                <Switch x:Name="swCasillero"
                        HorizontalOptions="Start"
                        OnColor="#6A1B9A"
                        Toggled="swCasillero_Toggled"
                        Grid.Row="2"
                        Grid.Column="1"/>

                <Label Text="Monto Inicial"
                       Style="{StaticResource labelGlobal}"
                       Grid.Row="3"
                       Grid.Column="0"/>

                <Entry x:Name="txtMontoInicial"
                       Style="{StaticResource entryGlobal}"
                       Placeholder="Entre 120 y 600"
                       Keyboard="Numeric"
                       TextChanged="txtMontoInicial_TextChanged"
                       Grid.Row="3"
                       Grid.Column="1"/>

                <Button x:Name="btnCalcular"
                        Style="{StaticResource BotonGlobal}"
                        Text="Calcular Pago mensual"
                        Clicked="btnCalcular_Clicked"
                        Grid.Row="4"
                        Grid.Column="0"/>

                <Entry x:Name="txtPagoMensual"
                       Style="{StaticResource entryGlobal}"
                       Placeholder="Pago mensual"
                       IsReadOnly="True"
                       Grid.Row="4"
                       Grid.Column="1"/>
            </Grid>

            <!--FUERA DEL GRID-->
            <Button x:Name="btnVerResumen"
                    Style="{StaticResource BotonGlobal}"
                    Text="Ver Resumen"
                    Clicked="btnVerResumen_Clicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
