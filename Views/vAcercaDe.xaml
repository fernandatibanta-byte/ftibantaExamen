<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ftibantaExamen.Views.vAcercaDe"
             Title="Acerca de">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label Text="ACERCA DE"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="Purple"
                   HorizontalOptions="Center"/>

            <!--FOTO LOCAL (Resources/Images)-->
            <Image Source="foto.png"
                   WidthRequest="180"
                   HeightRequest="180"
                   HorizontalOptions="Center"/>

            <Grid RowSpacing="10"
                  ColumnSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Text="Nombre:"
                       Style="{StaticResource labelGlobal}"
                       FontAttributes="Bold"
                       Grid.Row="0"
                       Grid.Column="0"/>

                <Label Text="Maria Fernanda Tibanta"
                       Style="{StaticResource labelGlobal}"
                       Grid.Row="0"
                       Grid.Column="1"/>

                <Label Text="Carrera:"
                       Style="{StaticResource labelGlobal}"
                       FontAttributes="Bold"
                       Grid.Row="1"
                       Grid.Column="0"/>

                <Label Text="Ingenieria en Sistemas"
                       Style="{StaticResource labelGlobal}"
                       Grid.Row="1"
                       Grid.Column="1"/>

                <Label Text="Paralelo:"
                       Style="{StaticResource labelGlobal}"
                       FontAttributes="Bold"
                       Grid.Row="2"
                       Grid.Column="0"/>

                <Label Text="A"
                       Style="{StaticResource labelGlobal}"
                       Grid.Row="2"
                       Grid.Column="1"/>

                <Label Text="Asignatura:"
                       Style="{StaticResource labelGlobal}"
                       FontAttributes="Bold"
                       Grid.Row="3"
                       Grid.Column="0"/>

                <Label Text="Desarrollo para dispositivos moviles"
                       Style="{StaticResource labelGlobal}"
                       Grid.Row="3"
                       Grid.Column="1"/>
            </Grid>

            <Button x:Name="btnRegresar"
                    Style="{StaticResource BotonGlobal}"
                    Text="Regresar"
                    Clicked="btnRegresar_Clicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
